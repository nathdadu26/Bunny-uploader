# ---------------- MongoDB ----------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bunny_r2_tg

# ---------------- Bunny Stream (Video Library) ----------------
BUNNY_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_STREAM_BASE_URL=https://video.bunnycdn.com

# ---------------- Bunny Storage Zone (where the finished zip lives) ----------------
# Bunny Stream automatically stores the encoded output (mp4/hls/thumbs/etc.)
# inside a storage zone connected to your video library. The zip of a video's
# full output is downloaded from:
# https://storage.bunnycdn.com/{BUNNY_STORAGE_ZONE_NAME}/{videoId}/?accessKey={BUNNY_STORAGE_PASSWORD}&download
BUNNY_STORAGE_ZONE_NAME=your-storage-zone-name
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_STORAGE_PULLZONE_HOST=storage.bunnycdn.com

# ---------------- Cloudflare R2 ----------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=videos
# Public base URL for the bucket (custom domain or r2.dev public URL), no trailing slash
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ---------------- Telegram ----------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ---------------- Streaming / mapping domain ----------------
# Only used to build the caption link posted to Telegram, e.g:
# https://STREAMING_DOMAIN/ad/{mapping}
# This project never creates/serves a streaming page itself.
STREAMING_DOMAIN=https://example.com

# ---------------- Misc ----------------
# Where zips are downloaded + extracted temporarily before upload to R2
TEMP_WORK_DIR=./tmp_processing
# How many videos to list per page in "My Files"
FILES_PAGE_SIZE=25
# Secret used to sign the simple dashboard session cookie
SESSION_SECRET=change-this-secret
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password

# ---------------- Deployment / keepalive (Koyeb free tier) ----------------
# Your Koyeb public URL, e.g. https://your-app-yourorg.koyeb.app
# Leave blank when running locally — self-ping is skipped automatically.
PUBLIC_URL=
SELF_PING_INTERVAL_MINUTES=4
# Koyeb injects PORT itself; only needed for local docker run overrides.
PORT=8000
